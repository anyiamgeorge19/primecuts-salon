# Copy this file to .env and fill in real values for LOCAL use only.
# In production, set these as Environment Variables in the Vercel dashboard instead
# (Vercel does not read a .env file from your repo).

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-secret

# False in production, True while developing locally
DEBUG=True

# Comma-separated list of extra hostnames allowed to serve the site.
# Not required locally. In production you can leave this blank -- Vercel's
# VERCEL_URL is trusted automatically by settings.py.
ALLOWED_HOSTS=

# Postgres connection string. Leave unset locally to use SQLite automatically.
# Vercel sets this for you automatically once you attach a Postgres database
# (Storage tab -> Create Database -> Postgres/Neon).
# DATABASE_URL=postgres://user:password@host:5432/dbname
